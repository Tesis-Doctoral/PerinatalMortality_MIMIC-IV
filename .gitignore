__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
*.log

# Local secrets -- never commit real DB credentials (the template .env.example is tracked)
.env
.env.*
!.env.example

# Local Postgres data volume and MIMIC-IV CSV files (restricted data, enormous)
postgres_data/
mimic_csv/

# Anything written to data/ is patient-level-adjacent and must never be committed, EXCEPT the
# aggregate text reports data/outputs_*.txt (counts and metrics only). Check each new
# outputs_*.txt before committing it.
data/*
!data/.gitkeep
!data/outputs_*.txt

# Spreadsheets and tables could hold patient-level rows
*.xlsx
*.csv
!sql/**/*.csv
# Lookup tables that map MIMIC-IV categories to the groups used as predictors (no patient data)
!data/*_groups.xlsx

# Local figures generated by the notebooks
figures/

# VS Code: share the project settings, ignore personal files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
